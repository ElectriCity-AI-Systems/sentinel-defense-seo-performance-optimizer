{
  "cooldown_after_rollback_minutes": 30,
  "emergency_stop_after_failed_rollbacks": 1,
  "name": "sentinel-automatic-rollback",
  "rollback_scope": "sentinel_owned_changes_only",
  "triggers": [
    "homepage_healthcheck_failed_twice",
    "wp_login_healthcheck_failed",
    "five_xx_increase_gte_10_percent",
    "browser_403_increase",
    "redirect_loop",
    "scope_mismatch",
    "policy_mismatch",
    "missing_rollback_artifact",
    "hash_mismatch",
    "adapter_error",
    "validation_timeout"
  ]
}
