{
  "schema_version": "sentinel-playbook-1",
  "playbook_id": "sentinel-origin-evidence-collector",
  "mode": "LOCAL_READ_ONLY_INPUT_NORMALIZATION",
  "source_scope": "fixed_project_local_spool",
  "accepted_formats": [
    "json",
    "jsonl",
    "log"
  ],
  "recognized_evidence": [
    "complete_exact_endpoint_origin_window_aggregate",
    "php_fatal",
    "wordpress_application_error",
    "origin_upstream_timeout",
    "origin_upstream_failure",
    "hosting_resource_limit",
    "database_failure",
    "origin_tls_failure"
  ],
  "privacy": {
    "raw_log_lines_stored": false,
    "file_names_stored": false,
    "paths_fingerprinted": true,
    "secret_rows_skipped": true
  },
  "aggregate_contract": {
    "evidence_kind": "NOWPLAYING_ORIGIN_WINDOW_AGGREGATE",
    "requires": [
      "verified evidence window",
      "Cloudflare reference snapshot and 504 count",
      "exact endpoint and origin",
      "total/local/remote status counts",
      "nginx and upstream timeout observations",
      "event-level correlation availability"
    ],
    "current_truth_rule": "Current counters are compatible only when Cloudflare count and snapshot/window align.",
    "historical_rule": "Incident-window evidence remains visible but cannot overwrite current truth.",
    "causality_proven": false
  },
  "remote_access": false,
  "production_write": false,
  "breach": false
}
