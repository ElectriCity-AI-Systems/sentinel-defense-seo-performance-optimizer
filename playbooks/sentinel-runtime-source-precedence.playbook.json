  "name": "sentinel-runtime-source-precedence",
  "owner_priority_ladder": [
    {
      "condition": "breach or emergency state",
      "priority": "SAFETY_BREACH_ESCALATION",
      "rank": 1
    },
    {
      "condition": "website outage or CRITICAL website status",
      "priority": "WEBSITE_ORIGIN_STABILITY",
      "rank": 2
    },
    {
      "condition": "dominant current origin failures",
      "priority": "WEBSITE_ORIGIN_STABILITY",
      "rank": 3
    },
    {
      "condition": "runtime or scheduler failure",
      "priority": "RUNTIME_STABILITY_REVIEW",
      "rank": 4
    },
    {
      "condition": "current TLS failure",
      "priority": "ORIGIN_TLS_REVIEW",
      "rank": 5
    },
    {
      "condition": "NowPlaying or API origin stability",
      "priority": "AI_RADIO_NOWPLAYING_RECOVERY",
      "rank": 6
    },
    {
      "condition": "performance degradation",
      "priority": "PERFORMANCE_DEGRADATION_REVIEW",
      "rank": 7
    },
    {
      "condition": "security diagnostic review",
      "priority": "SECURITY_DIAGNOSTIC_REVIEW",
      "rank": 8
    },
    {
      "condition": "SEO or editorial work",
      "priority": "SEO_TITLE_REVIEW",
      "rank": 9
    }
  ],
  "precedence": [
    {
      "description": "current live runtime state",
      "source_class": "CURRENT_RUNTIME",
      "tier": 1
