{
  "schema_version": "sentinel-playbook-1",
  "playbook_id": "sentinel-remediation-change-budget",
  "mode": "FAIL_CLOSED",
  "limits": {
    "max_active_actions": 1,
    "max_actions_per_hour": 1,
    "max_failed_actions_per_hour": 1,
    "max_failed_rollbacks": 0,
    "maximum_ttl_minutes": 10,
