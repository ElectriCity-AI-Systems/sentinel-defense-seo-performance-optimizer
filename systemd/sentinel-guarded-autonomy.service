[Unit]
Description=Sentinel Guarded Autonomy Cycle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/srv/sentinel-defense
EnvironmentFile=/etc/sentinel-defense.env
ExecStart=/usr/bin/python3 /srv/sentinel-defense/sentinel_guarded_autonomy.py --run-cycle
TimeoutStartSec=100
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/srv/sentinel-defense/config /srv/sentinel-defense/playbooks
ReadWritePaths=/srv/sentinel-defense/reports /srv/sentinel-defense/state /srv/sentinel-defense/audit

[Install]
WantedBy=multi-user.target
